import os
from pypdf import PdfWriter
from google.colab import files

def advanced_merge_pdfs():
    # 1. 上傳檔案
    print("請選擇要合併的 PDF 檔案（可多選）：")
    uploaded = files.upload()
    file_names = list(uploaded.keys())

    if len(file_names) < 2:
        print("❌ 錯誤：請至少上傳兩個檔案。")
        return

    # 排序檔案 (按檔名排序)
    file_names.sort()
    print(f"\n📂 已偵測到檔案：{file_names}")

    # 2. 使用者設定：自定義檔名
    custom_name = input("\n請輸入合併後的檔案名稱 (例如: report，不需輸入 .pdf): ")
    if not custom_name.strip():
        custom_name = "merged_document"
    output_filename = f"{custom_name}.pdf"

    # # 3. 使用者設定：選擇合併模式
    # print("\n請選擇合併模式：")
    # print("1. 合併「完整」文件")
    # print("2. 只取每個檔案的「第一頁」")
    # mode = input("請輸入數字 (1 或 2): ")

    # 4. 開始合併
    merger = PdfWriter()

    try:
        for pdf in file_names:
            # if mode == '2':
            #     # pages=(從第幾頁, 到第幾頁) -> (0, 1) 代表只取第 0 頁
            #     merger.append(pdf, pages=(0, 1))
            #     print(f" - 已加入 {pdf} 的第 1 頁")
            # else:
                merger.append(pdf)
                print(f" - 已加入 {pdf} 的全部頁面")

        # 5. 儲存與下載
        with open(output_filename, "wb") as f:
            merger.write(f)

        merger.close()
        print(f"\n✅ 成功！成品已命名為：{output_filename}")

        files.download(output_filename)

    except Exception as e:
        print(f"❌ 發生錯誤：{e}")

# 執行升級版函式
advanced_merge_pdfs()
